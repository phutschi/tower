#!/usr/bin/env bash
# Stand-in for plannotator in the Panel's tests. Logs each call to
# PLANNOTATOR_STUB_LOG as `plannotator <args>`, the JSON argument last.
# `inbox call send_message` answers a message in thread thr_1, at cursor s<n>
# for the nth send.
# While a file PLANNOTATOR_STUB_LOG.fail exists, `send_message` fails; when
# the file holds text, only a send whose JSON argument contains it fails.
# `inbox call read_thread` with no thread_id lists the file
# PLANNOTATOR_STUB_THREADS names ({"threads":[]} without one); with one it answers the thread in the file PLANNOTATOR_STUB_THREAD
# names, or an empty one while there is no file or its cursor is the `after`
# asked for.
# While the file PLANNOTATOR_STUB_FAIL names is there, every call fails.
printf 'plannotator %s\n' "$*" >> "${PLANNOTATOR_STUB_LOG:-/dev/null}"
[ -n "${PLANNOTATOR_STUB_FAIL:-}" ] && [ -f "$PLANNOTATOR_STUB_FAIL" ] && { echo "plannotator: the Inbox is down (stub)" >&2; exit 1; }
case "${1:-} ${2:-} ${3:-}" in
  "inbox call send_message")
    fail="${PLANNOTATOR_STUB_LOG:-/dev/null}.fail"
    if [ -e "$fail" ] && { [ ! -s "$fail" ] || printf '%s' "${4:-}" | grep -qF -- "$(cat "$fail")"; }; then
      echo "plannotator: the Inbox is not answering (stub)" >&2; exit 1
    fi
    n=$(grep -c "send_message" "${PLANNOTATOR_STUB_LOG:-/dev/null}" 2>/dev/null || echo 1)
    printf '{"message_id":"msg_s%s","thread_id":"thr_1","cursor":"s%s"}\n' "$n" "$n" ;;
  "inbox call read_thread")
    # Without a thread id: the project's threads, from PLANNOTATOR_STUB_THREADS.
    if [ "$(printf '%s' "${4:-{\}}" | jq -r '.thread_id // ""')" = "" ] && [ "$(printf '%s' "${4:-{\}}" | jq -r '.message_id // ""')" = "" ]; then
      cat "${PLANNOTATOR_STUB_THREADS:-/dev/null}" 2>/dev/null || true
      [ -f "${PLANNOTATOR_STUB_THREADS:-}" ] || echo '{"threads":[]}'
      exit 0
    fi
    after=$(printf '%s' "${4:-{\}}" | jq -r '.after // ""')
    file=${PLANNOTATOR_STUB_THREAD:-}
    if [ -f "$file" ] && [ "$(jq -r .cursor "$file")" != "$after" ]; then cat "$file"
    else printf '{"thread":{"messages":[]},"cursor":"%s"}\n' "$after"; fi ;;
  *) echo "plannotator: unknown command $* (stub)" >&2; exit 2 ;;
esac

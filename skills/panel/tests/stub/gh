#!/usr/bin/env bash
# Stand-in for gh in the Panel's tests. Logs argv to GH_STUB_LOG. Each repo's
# open issues live in GH_STUB_DIR/<owner>_<repo>.json, as `gh issue list
# --json number,title,labels` prints them; a repo without a file has none.
# A repo's labels are the lines of GH_STUB_DIR/<owner>_<repo>.labels: `label
# create` adds one, and fails as gh does for one the repo has already.
# `issue view N` answers that issue's title, body and labels; `issue edit`
# changes its labels in the file, so the next list sees the edit, and with
# `--body-file -` writes the body it reads to GH_STUB_DIR/<owner>_<repo>_N.body.
# Its open pull requests live in GH_STUB_DIR/<owner>_<repo>.prs.json, as `gh pr
# list --json number,isDraft,createdAt,closingIssuesReferences` prints them.
# `api repos/<owner>/<repo>/contents/CONTEXT-MAP.md` answers {} when the file
# GH_STUB_DIR/<owner>_<repo>.context-map exists, and GitHub's 404 when not.
# `api repos/<owner>/<repo>/commits/HEAD` answers the head of main from
# GH_STUB_DIR/<owner>_<repo>.head (0 without one); `api repos/…/commits?…`
# its latest commits from GH_STUB_DIR/<owner>_<repo>.commits.json ([] without
# one); `api repos/…/issues/N`
# answers that issue's id, 1000+N. `api repos/…/issues/N/dependencies/blocked_by`
# lists, or with -X POST adds, the blockers in GH_STUB_DIR/<owner>_<repo>.deps,
# one `N <blocker id>` line each; a blocker is open while it is in the repo's
# open issues. Any other `api` call answers {}.
# GH_STUB_FAIL=<verb> makes that verb fail: list or edit; so does a file
# GH_STUB_DIR/fail holding the verb, while it is there.
printf 'gh %s\n' "$*" >> "${GH_STUB_LOG:-/dev/null}"
repo=""; add=(); remove=(); args=(); method=GET; field=""; body_file=""
while [ $# -gt 0 ]; do
  case "$1" in
    --repo) repo=$2; shift ;;
    --add-label) add+=("$2"); shift ;;
    --remove-label) remove+=("$2"); shift ;;
    -X) method=$2; shift ;;
    --body-file) body_file=$2; shift ;;
    -F) field=$2; shift ;;
    --json|--limit|--state|--jq|-H|-f) shift ;;
    *) args+=("$1") ;;
  esac
  shift
done
file="${GH_STUB_DIR:?}/${repo/\//_}.json"
verb="${args[0]:-} ${args[1]:-}"
fail=${GH_STUB_FAIL:-$(cat "$GH_STUB_DIR/fail" 2>/dev/null)}
[ -n "$fail" ] && [ "${args[1]:-}" = "$fail" ] && { echo "gh: ${args[1]} failed (stub)" >&2; exit 1; }
case "$verb" in
  "issue list") if [ -f "$file" ]; then cat "$file"; else echo "[]"; fi ;;
  "pr list") if [ -f "${file%.json}.prs.json" ]; then cat "${file%.json}.prs.json"; else echo "[]"; fi ;;
  "issue view") jq --argjson n "${args[2]:?}" '.[] | select(.number == $n) | {title, body: (.body // ""), labels}' "$file" ;;
  "label create") labels="${file%.json}.labels"
    if grep -qxF -- "${args[2]:?}" "$labels" 2>/dev/null; then
      echo "label with name \"${args[2]}\" already exists; use \`--force\` to update its color and description" >&2; exit 1
    fi
    echo "${args[2]}" >> "$labels" ;;
  "issue edit")
    number=${args[2]:?}
    [ "$body_file" = - ] && cat > "${file%.json}_$number.body"
    adds=$(printf '%s\n' "${add[@]}" | jq -R . | jq -s 'map(select(. != ""))')
    removes=$(printf '%s\n' "${remove[@]}" | jq -R . | jq -s 'map(select(. != ""))')
    jq --argjson n "$number" --argjson add "$adds" --argjson rm "$removes" '
      map(if .number == $n
          then .labels = ([.labels[] | select(.name as $l | $rm | index($l) | not)]
                          + [$add[] | {name: .}])
          else . end)' "$file" > "$file.next" && mv "$file.next" "$file" ;;
  "api "*)
    case "${args[1]}" in
      repos/*/contents/CONTEXT-MAP.md) r=${args[1]#repos/}; r=${r%%/contents/*}
        [ -f "$GH_STUB_DIR/${r/\//_}.context-map" ] || { echo "gh: Not Found (HTTP 404)" >&2; exit 1; }
        echo "{}" ;;
      repos/*/commits/HEAD) head=${args[1]#repos/}; head=${head%/commits/HEAD}
        cat "$GH_STUB_DIR/${head/\//_}.head" 2>/dev/null || echo 0 ;;
      repos/*/commits\?*) r=${args[1]#repos/}; r=${r%/commits\?*}
        cat "$GH_STUB_DIR/${r/\//_}.commits.json" 2>/dev/null || echo "[]" ;;
      repos/*/issues/*[0-9]) echo "{\"id\": $((1000 + ${args[1]##*/}))}" ;;
      repos/*/issues/*/dependencies/blocked_by)
        r=${args[1]#repos/}; r=${r%%/issues/*}; deps="$GH_STUB_DIR/${r/\//_}.deps"
        n=${args[1]%/dependencies/blocked_by}; n=${n##*/}; touch "$deps"
        if [ "$method" = POST ]; then echo "$n ${field#issue_id=}" >> "$deps"; echo "{}"
        else awk -v n="$n" 'BEGIN { printf "[" } $1 == n { printf "%s{\"id\":%s,\"number\":%s}", (c++ ? "," : ""), $2, $2 - 1000 }
          END { print "]" }' "$deps" \
          | jq --slurpfile open "$GH_STUB_DIR/${r/\//_}.json" \
            'map(.number as $b | . + {state: (if ($open[0] | map(.number) | index($b)) == null then "closed" else "open" end)})'; fi ;;
      *) echo "{}" ;;
    esac ;;
  *) echo "gh: unknown command $verb (stub)" >&2; exit 1 ;;
esac

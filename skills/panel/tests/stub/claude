#!/usr/bin/env bash
# Stand-in for claude in the Panel's tests. Logs argv to CLAUDE_STUB_LOG and
# appends the prompt it reads on stdin to CLAUDE_STUB_LOG.prompts, one
# `--- prompt` line before each. Answers the stream-json lines of the file
# CLAUDE_STUB_OUT names, and exits CLAUDE_STUB_EXIT (0 unset). CLAUDE_STUB_RUN is
# a shell command it runs first, as something that happens while a session runs.
printf 'claude %s\n' "$*" >> "${CLAUDE_STUB_LOG:-/dev/null}"
{ echo "--- prompt"; cat; echo; } >> "${CLAUDE_STUB_LOG:-/dev/null}.prompts"
[ -n "${CLAUDE_STUB_RUN:-}" ] && sh -c "$CLAUDE_STUB_RUN"
[ -n "${CLAUDE_STUB_OUT:-}" ] && cat "$CLAUDE_STUB_OUT"
exit "${CLAUDE_STUB_EXIT:-0}"

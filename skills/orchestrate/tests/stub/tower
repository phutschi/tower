#!/usr/bin/env bash
# tower under DRY_RUN=1 and test.sh: the real CLI from this checkout
# (src/cli.ts, run with bun), so a change to tower's commands or to
# `tower state --json` breaks the kit's tests in the same change.
# TOWER_STUB=absent refuses to run, so tower counts as not runnable (the kit
# then refuses to start).
[ "${TOWER_STUB:-}" = absent ] && { echo "tower: not installed (stub)" >&2; exit 127; }
exec bun "$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../.." && pwd)/src/cli.ts" "$@"
